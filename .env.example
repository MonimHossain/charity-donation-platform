# App
APP_URL=http://localhost:3001
NEXT_PUBLIC_APP_URL=http://localhost:3001
NEXT_PUBLIC_API_URL=http://localhost:4000/api/v1
# Must be the public API URL including /api/v1 (used for Google OAuth redirect_uri)
BACKEND_API_URL=http://localhost:4000/api/v1
NODE_ENV=development

# Database
DB_HOST=localhost
DB_PORT=54322
DB_USERNAME=admin
DB_PASSWORD=admin123
DB_DATABASE=charity_platform
DB_SYNCHRONIZE=true
DB_LOGGING=false

# Redis
REDIS_PORT=63793

# Admin
ADMIN_EMAIL=admin@charityplatform.org
ADMIN_FULL_NAME=Platform Admin
ADMIN_PASSWORD=Admin123!
ADMIN_JWT_SECRET=charity-platform-jwt-secret-change-me
ADMIN_JWT_EXPIRES_IN=7d
ADMIN_COOKIE_MAX_AGE_MS=604800000
ADMIN_RESET_SECRET=charity-reset-secret-change-me

# SMTP
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-password
SMTP_FROM_NAME=Charity Platform
SMTP_FROM_EMAIL=noreply@charityplatform.org
# Set true on staging/production to send transactional mail
EMAIL_ENABLED=false

# Optional public GTM override (admin CMS site settings gtmId takes precedence when set)
NEXT_PUBLIC_GTM_ID=
# Server-side GTM subdomain — enables stealth /moondance loader (e.g. assets.yourimpactdev.com)
NEXT_PUBLIC_SGTM_HOST=

# MinIO (S3-compatible)
MINIO_ENDPOINT=localhost
MINIO_PORT=9002
MINIO_USE_SSL=false
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET_MEDIA=charity-media
MINIO_BUCKET_NAME=charity-media
MINIO_PRESIGNED_EXPIRY=3600
MINIO_PUBLIC_ENDPOINT=http://localhost:9002
# Browser-facing media URL (optional). New uploads use relative `/charity-media/...` paths
# proxied by Next.js (dev) or nginx (production). Direct MinIO URL also works in dev:
MINIO_PUBLIC_BASE_URL=http://localhost:9002/charity-media

# User auth (donor accounts)
USER_JWT_SECRET=change-me-user-jwt-secret
USER_JWT_EXPIRES_IN=7d
USER_COOKIE_MAX_AGE_MS=604800000
USER_RESET_SECRET=change-me-user-reset-secret

# Google SSO (optional — enables "Continue with Google")
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Apple SSO (optional — enables "Continue with Apple")
APPLE_CLIENT_ID=
APPLE_TEAM_ID=
APPLE_KEY_ID=
APPLE_PRIVATE_KEY=

# Stripe
# Stripe (cards, Apple Pay, Google Pay)
STRIPE_SECRET_KEY=sk_test_xxx
# Local dev: run `pnpm --filter api stripe:listen` — it prints whsec_... paste below
# Dashboard webhooks (production): Developers → Webhooks → Add endpoint → /api/v1/payments/stripe/webhook
STRIPE_WEBHOOK_SECRET=whsec_xxx
# Optional local dev without Stripe CLI (uses /payments/stripe/confirm after pay instead)
STRIPE_WEBHOOK_SKIP_VERIFY=true
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_xxx

# PayPal
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_MODE=sandbox
NEXT_PUBLIC_PAYPAL_CLIENT_ID=

# Telr
TELR_STORE_ID=
TELR_AUTH_KEY=
TELR_TEST_MODE=true

# PayTabs
PAYTABS_PROFILE_ID=
PAYTABS_SERVER_KEY=
PAYTABS_CLIENT_KEY=
NEXT_PUBLIC_PAYTABS_CLIENT_KEY=
PAYTABS_REGION=ARE

# Optional — live gold/silver spot prices for Zakat calculator (https://www.goldapi.io — free tier)
GOLD_API_KEY=
# Alternatives (first configured provider wins): https://metals-api.com or https://metalpriceapi.com
METALS_API_KEY=
METALPRICE_API_KEY=

# Seed
SEED_DATA=true
